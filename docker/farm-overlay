#!/bin/bash
# Bring up the farm's VXLAN mesh described by /etc/farm/overlay.conf.
# Peers are reached through UDP ports published on the msb host, so every
# FDB entry points at the host alias with the peer's published port.
set -euo pipefail
. /etc/farm/overlay.conf

case "${1:-up}" in
up)
  host=""
  for _ in $(seq 30); do
    host=$(getent ahostsv4 host.microsandbox.internal | awk 'NR==1{print $1}')
    [ -n "$host" ] && break
    sleep 1
  done
  [ -n "$host" ] || { echo "cannot resolve host.microsandbox.internal" >&2; exit 1; }

  ip link del vx0 2>/dev/null || true
  ip link add vx0 type vxlan id "$VNI" dstport 4789 nolearning
  ip link set vx0 mtu 1400 up
  ip addr add "$ADDRESS" dev vx0
  for port in $PEER_PORTS; do
    bridge fdb append 00:00:00:00:00:00 dev vx0 dst "$host" port "$port"
  done
  ;;
down)
  ip link del vx0 2>/dev/null || true
  ;;
esac
