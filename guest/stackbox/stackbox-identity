#!/bin/bash
# msb derives eth0's address from a slot that may change on every start, and a
# restored snapshot boots under a new sandbox name. Give the guest a fixed
# hostname and a fixed service address so OpenStack keeps the identity it was
# deployed with; published ports reach it through DNAT. The address sits on a dummy
# interface, or on a multi-node stackbox's management link, which stackbox-link@stackbox0 creates first.
set -euo pipefail
conf=/etc/stackbox/identity.conf
[ -f "$conf" ] || exit 0
. "$conf"
hostname "$STACKBOX_HOSTNAME"
echo "$STACKBOX_HOSTNAME" > /etc/hostname
if ip link show stackbox0 >/dev/null 2>&1; then
  ip addr replace "$STACKBOX_ADDRESS/$STACKBOX_PREFIX" dev stackbox0
  ip link set stackbox0 up
elif [ ! -f /etc/stackbox/link-stackbox0.conf ]; then
  ip link add stackbox0 type dummy
  ip addr replace "$STACKBOX_ADDRESS/$STACKBOX_PREFIX" dev stackbox0
  ip link set stackbox0 up
fi
# A multi-node VM whose links are off (frozen, or restored before it has its own ports) gets
# stackbox0 from stackbox-link@stackbox0, which sets the address itself; a dummy here would block its TAP.
nft delete table ip stackbox_identity 2>/dev/null || true
# A multi-node stackbox's compute VMs publish nothing.
[ -n "${STACKBOX_PORTS:-}" ] || exit 0
nft -f - <<NFT
table ip stackbox_identity {
  chain prerouting {
    type nat hook prerouting priority dstnat;
    iifname "eth0" tcp dport { ${STACKBOX_PORTS// /, } } dnat to $STACKBOX_ADDRESS
  }
}
NFT
