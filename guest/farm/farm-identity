#!/bin/bash
# msb derives eth0's address from a slot that may change on every start, and a
# restored snapshot boots under a new sandbox name. Give the guest a fixed
# hostname and a fixed service address so OpenStack keeps the identity it was
# deployed with; published ports reach it through DNAT. The address sits on a dummy
# interface, or on a multi-node farm's management link, which farm-link@farm0 creates first.
set -euo pipefail
conf=/etc/farm/identity.conf
[ -f "$conf" ] || exit 0
. "$conf"
hostname "$FARM_HOSTNAME"
echo "$FARM_HOSTNAME" > /etc/hostname
if ip link show farm0 >/dev/null 2>&1; then
  ip addr replace "$FARM_ADDRESS/$FARM_PREFIX" dev farm0
  ip link set farm0 up
elif [ ! -f /etc/farm/link-farm0.conf ]; then
  ip link add farm0 type dummy
  ip addr replace "$FARM_ADDRESS/$FARM_PREFIX" dev farm0
  ip link set farm0 up
fi
# A multi-node VM whose links are off (frozen, or restored before it has its own ports) gets
# farm0 from farm-link@farm0, which sets the address itself; a dummy here would block its TAP.
nft delete table ip farm_identity 2>/dev/null || true
# A multi-node farm's compute VMs publish nothing.
[ -n "${FARM_PORTS:-}" ] || exit 0
nft -f - <<NFT
table ip farm_identity {
  chain prerouting {
    type nat hook prerouting priority dstnat;
    iifname "eth0" tcp dport { ${FARM_PORTS// /, } } dnat to $FARM_ADDRESS
  }
}
NFT
