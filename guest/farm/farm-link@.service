[Unit]
Description=Farm L2 link %i
After=network-online.target
Wants=network-online.target
Before=farm-identity.service farm-hostname.service docker.service
ConditionPathExists=/etc/farm/link-%i.conf

[Service]
# Creates the persistent TAP with its MTU and address, so they exist before the services
# that bind to it start, and survive the link process restarting.
ExecStartPre=/usr/local/sbin/farm-agent agent link --setup /etc/farm/link-%i.conf
ExecStart=/usr/local/sbin/farm-agent agent link /etc/farm/link-%i.conf
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
