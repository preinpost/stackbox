#!/bin/bash
# Route Neutron's userspace br-ex to this VM's eth0. No inter-VM overlay needed.
set -euo pipefail
[ -f /etc/farm/external.conf ] || exit 0
. /etc/farm/external.conf
ip link show farm-ext >/dev/null 2>&1 || ip link add farm-ext type veth peer name farm-extgw
ip link set farm-ext up
ip link set farm-extgw up
ip addr replace "$EXTERNAL_GATEWAY" dev farm-extgw
sysctl -qw net.ipv4.ip_forward=1
# Kernel iptables extensions are deliberately unavailable in msb. Preserve the
# proven nftables masquerading used by the previous Neutron compute node.
nft delete table ip farm_external 2>/dev/null || true
nft -f - <<NFT
table ip farm_external {
  chain postrouting {
    type nat hook postrouting priority srcnat;
    ip saddr $EXTERNAL_NETWORK oifname "eth0" masquerade
  }
}
NFT
