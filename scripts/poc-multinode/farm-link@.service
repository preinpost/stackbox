[Unit]
Description=Farm L2 link %i
After=network-online.target
Wants=network-online.target
Before=farm-identity.service docker.service
ConditionPathExists=/etc/farm/link-%i.conf

[Service]
EnvironmentFile=/etc/farm/link-%i.conf
ExecStart=/usr/local/bin/farm-link link --switch ${SWITCH} --dev %i
# The TAP lives only as long as farm-link, so configure it on every start.
ExecStartPost=/bin/sh -c 'for _ in $$(seq 50); do ip link show %i >/dev/null 2>&1 && break; sleep 0.1; done; ip link set %i mtu 9000 up; [ -z "$${ADDRESS}" ] || ip addr replace "$${ADDRESS}" dev %i'
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
