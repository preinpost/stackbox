# VFIO/mdev framework and the kernel sample mtty driver, so Nova's vGPU path (mtty-1 as an
# enabled_mdev_type) can be tested without a GPU.

# Every symbol here must end up built in (=y): the guest kernel has no module loading, and
# scripts/build-libkrunfw.sh fails when one does not. olddefconfig fills in what these select:
# VFIO_GROUP, VFIO_CONTAINER, VFIO_PCI_CORE, IOMMU_API, IOMMU_DMA and the like.
CONFIG_IOMMU_SUPPORT=y
CONFIG_VFIO=y
CONFIG_VFIO_MDEV=y
CONFIG_VFIO_IOMMU_TYPE1=y
CONFIG_PCI=y
CONFIG_VFIO_PCI=y
CONFIG_SAMPLES=y
CONFIG_SAMPLE_VFIO_MDEV_MTTY=y
