# CONNMARK, which Neutron's L3 agent writes into every router's mangle table: it stores the
# address-scope mark on a connection (--save-mark) and restores it on the next packet
# (--restore-mark). The guest kernel had NF_CONNTRACK and the xtables match/target disabled,
# so iptables-restore rejected each router's rules and the qrouter namespace came and went.
# This is not release-specific: 2025.1 through 2026.2 all add these rules when they use the
# legacy L3 agent. ip6_tables itself is built in (IP6_NF_IPTABLES and its legacy tables), so
# the ip6tables rules need no module either; farm empties Neutron's module list in globals.
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NETFILTER_XT_CONNMARK=y
CONFIG_NETFILTER_XT_TARGET_CONNMARK=y
CONFIG_NETFILTER_XT_MATCH_CONNMARK=y
