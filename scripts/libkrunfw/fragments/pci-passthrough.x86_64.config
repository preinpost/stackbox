# PCI and IOMMU settings x86_64 needs before a host PCI device can be passed through to a guest
# (VFIO-PCI, with vIOMMU advertised through ACPI): ACPI's VIOT table names the virtio IOMMU, and
# MSI routes interrupts. libkrun places a passed-through endpoint directly on PCI bus 0; it does
# not create PCIe root ports, so PCIEPORTBUS is enabled only for the port and capability support
# the guest kernel expects. The USB xHCI controller is the device a passthrough test attaches.
# Only x86_64-specific or not-yet-enabled settings belong here; PCI, IOMMU_SUPPORT and VFIO_PCI
# come from vfio-mtty.config.

# Every symbol here must end up built in (=y): the guest kernel has no module loading, and
# scripts/build-libkrunfw.sh fails when one does not.
CONFIG_ACPI=y
CONFIG_ACPI_VIOT=y
CONFIG_PCI_MMCONFIG=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_VIRTIO_IOMMU=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
